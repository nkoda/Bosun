{
  "name": "fleet-view",
  "displayName": "Fleet View",
  "description": "Live view of ~/.claude/fleet fleets: workers, sessions, changes, diagrams and review comments.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:fleetView.panel"],
  "contributes": {
    "views": {
      "explorer": [{ "type": "webview", "id": "fleetView.sidebar", "name": "Fleet", "icon": "$(server-process)" }]
    },
    "commands": [
      { "command": "fleetView.open", "title": "Fleet: Open Dashboard", "icon": "$(preview)" },
      { "command": "fleetView.goTo", "title": "Fleet: Go to Worker…" },
      { "command": "fleetView.openBrowser", "title": "Fleet: Open Dashboard in Browser" },
      { "command": "fleetView.restartServer", "title": "Fleet: Restart Server" },
      { "command": "fleetView.inspect", "title": "Inspect", "icon": "$(search)" },
      { "command": "fleetView.review", "title": "Review", "icon": "$(eye)" },
      { "command": "fleetView.change", "title": "Change", "icon": "$(edit)" },
      { "command": "fleetView.followUp", "title": "Reply" },
      { "command": "fleetView.complete", "title": "Mark complete", "icon": "$(pass)" },
      { "command": "fleetView.reopen", "title": "Reopen", "icon": "$(issue-reopened)" }
    ],
    "menus": {
      "commandPalette": [{ "command": "fleetView.inspect", "when": "false" }, { "command": "fleetView.review", "when": "false" }, { "command": "fleetView.change", "when": "false" }, { "command": "fleetView.followUp", "when": "false" }, { "command": "fleetView.complete", "when": "false" }, { "command": "fleetView.reopen", "when": "false" }],
      "view/title": [{ "command": "fleetView.open", "when": "view == fleetView.sidebar", "group": "navigation" }],
      "comments/commentThread/context": [
        { "command": "fleetView.inspect", "group": "inline@1", "when": "commentController == fleetView.review && commentThreadIsEmpty" },
        { "command": "fleetView.review", "group": "inline@2", "when": "commentController == fleetView.review && commentThreadIsEmpty" },
        { "command": "fleetView.change", "group": "inline@3", "when": "commentController == fleetView.review && commentThreadIsEmpty" },
        { "command": "fleetView.followUp", "group": "inline", "when": "commentController == fleetView.review && !commentThreadIsEmpty" }
      ],
      "comments/commentThread/title": [
        { "command": "fleetView.complete", "group": "inline", "when": "commentController == fleetView.review && commentThread =~ /^(open|answered)$/" },
        { "command": "fleetView.reopen", "group": "inline", "when": "commentController == fleetView.review && commentThread == complete" }
      ],
      "commentsView/commentThread/context": [
        { "command": "fleetView.complete", "group": "inline", "when": "commentController == fleetView.review && commentThread =~ /^(open|answered)$/" },
        { "command": "fleetView.reopen", "group": "inline", "when": "commentController == fleetView.review && commentThread == complete" }
      ]
    },
    "configuration": {
      "title": "Fleet View",
      "properties": {
        "fleetView.dir": { "type": "string", "default": "", "description": "One more fleet folder (holds fleet.conf) to show, besides the fleet the workspace is inside and the fleets under its folders." },
        "fleetView.port": { "type": "number", "default": 7420, "description": "Port the first fleet's server asks for (127.0.0.1 only). Other fleets take a free port." },
        "fleetView.openIn": { "type": "string", "enum": ["tab", "terminal"], "enumDescriptions": ["A Claude Code tab in this window", "claude --resume in a terminal"], "default": "tab", "description": "Where Open sends a session. ⌥-click Open for the other one." }
      }
    }
  }
}
